<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="nopcommerce Regression suite" parallel="tests" thread-count="2">
  <test name="Chrome Regression Test">
  	<parameter name="browser" value="chrome"/>
  	<parameter name="platform" value="OS X 10"/>
    <classes>
      <class name="tests.UserRegistrationTestGrid"/>
      <class name="tests.MyAccountTestGrid"/>
    </classes>
  </test>
  <test name="Firefox Regression Test">
  	<parameter name="browser" value="firefox"/>
  	<parameter name="platform" value="Windows 10"/>
    <classes>
      <class name="tests.UserRegistrationTestGrid"/>
    </classes>
  </test>
</suite>
